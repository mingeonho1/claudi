<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.claudi.enforcer</string>
	<key>ProcessType</key><string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{PYTHON}}</string>
		<string>{{CLAUDE_DIR}}/enforce/bin/launchd-check.py</string>
	</array>
	<key>RunAtLoad</key><true/>
	<key>StartInterval</key><integer>3600</integer>
	<key>StandardOutPath</key><string>{{CLAUDE_DIR}}/enforce/logs/launchd.out.log</string>
	<key>StandardErrorPath</key><string>{{CLAUDE_DIR}}/enforce/logs/launchd.err.log</string>
</dict>
</plist>
